datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String
  image     String?          @db.Text
  role      String           @default("user") // "user" | "admin"
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  progress  LessonProgress[]
}

model Course {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(500)
  description String       @db.Text
  thumbnail   String       @db.Text
  category    String       // "Lập trình", "Ngoại ngữ", "Thiết kế"
  instructor  String?
  level       String?      @default("Tất cả trình độ")
  duration    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  nodes       CourseNode[]
}

model CourseNode {
  id          String           @id @default(cuid())
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      CourseNode?      @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    CourseNode[]     @relation("NodeHierarchy")
  type        String           // "chapter", "folder", "lesson"
  title       String           @db.VarChar(500)
  url         String?          @db.Text // video / drive url
  duration    String?          // e.g. "12:30"
  position    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  progress    LessonProgress[]

  @@index([courseId])
  @@index([parentId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       CourseNode @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean    @default(false)
  lastPosition Float      @default(0)
  completedAt  DateTime?
  updatedAt    DateTime   @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}
